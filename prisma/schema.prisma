generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  BREAKDOWN
}

enum VehicleType {
  CAR
  VAN
  HIJET
  KARVAN
  BUS
}

enum DriverStatus {
  AVAILABLE
  ON_RIDE
  OFFLINE
  INACTIVE
}

enum DriverShiftType {
  TWELVE_HOUR
  TWENTY_FOUR_HOUR
  SINGLE_SHIFT
  FIXED_SHIFT
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Entity {
  IBEX
  VW
}

enum OfficeLocation {
  IBT_1
  IBT_2
  IBT_3
  SKY_TOWER
}

enum ServiceType {
  PICK_AND_DROP
  DROP_ONLY
  PICK_ONLY
}

enum RouteStatus {
  ACTIVE
  INACTIVE
}

enum RideStatus {
  PENDING
  STARTED
  ARRIVED
  COMPLETED
  CANCELLED
}

enum VendorStatus {
  ACTIVE
  INACTIVE
}

enum ComplaintCategory {
  DRIVER_BEHAVIOUR
  VEHICLE_CONDITION
  ROUTE_ISSUE
  TIMING_DELAY
  SCHEDULING
  OTHER
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  NO_SHOW
}

enum ScheduleStatus {
  ACTIVE
  DRAFT
  CANCELLED
}

enum DayStatus {
  PICKUP
  DROP
  BOTH
  OFF
  ABSENT
}

enum UserRole {
  ADMIN
  MANAGER
  DISPATCHER
  DRIVER
  EMPLOYEE
}

enum NotificationStatus {
  UNREAD
  READ
}

enum DevicePlatform {
  IOS
  ANDROID
}

model Area {
  id        String   @id @default(uuid())
  name      String   @unique
  city      String   @default("Karachi")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subAreas  SubArea[]
  employees Employee[]
  routes    Route[]
  rides     Ride[]
}

model SubArea {
  id        String   @id @default(uuid())
  name      String
  areaId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  area      Area       @relation(fields: [areaId], references: [id], onDelete: Cascade)
  blocks    Block[]
  employees Employee[]
  routes    Route[]
  rides     Ride[]

  @@unique([name, areaId])
  @@index([areaId])
}

model Block {
  id        String   @id @default(uuid())
  name      String
  subAreaId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subArea   SubArea    @relation(fields: [subAreaId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([name, subAreaId])
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]
}

model Vendor {
  id            String       @id @default(uuid())
  name          String       @unique
  shortName     String?
  contactPerson String?
  phone         String?
  email         String?
  status        VendorStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  vehicles        Vehicle[]
  drivers         Driver[]
  rides           Ride[]
  weeklySchedules WeeklySchedule[]
}

model Vehicle {
  id            String        @id @default(uuid())
  vehicleNumber String        @unique
  type          VehicleType
  make          String?
  model         String?
  year          String?
  capacity      Int
  vendorId      String?
  status        VehicleStatus @default(ACTIVE)
  notes         String?
  vehicleEntity Entity?

  // one vehicle ↔ one driver
  driverId String? @unique
  driver   Driver? @relation(fields: [driverId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor          Vendor?          @relation(fields: [vendorId], references: [id])
  rides           Ride[]
  complaints      Complaint[]
  weeklySchedules WeeklySchedule[]
  trips           Trip[]
}

model Driver {
  id            String  @id @default(uuid())
  name          String
  phone         String?
  licenseNumber String? @unique
  cnic          String? @unique
  vendorId      String?
  userId        String? @unique

  shiftType       DriverShiftType  @default(TWELVE_HOUR)
  shiftLabel      String?
  status          DriverStatus     @default(AVAILABLE)
  notes           String?
  vendor          Vendor?          @relation(fields: [vendorId], references: [id])
  user            User?            @relation("DriverUser", fields: [userId], references: [id], onDelete: SetNull)
  vehicle         Vehicle?
  rides           Ride[]
  trips           Trip[]
  complaints      Complaint[]
  weeklySchedules WeeklySchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cnic, licenseNumber, userId])
}

model Route {
  id             String          @id @default(uuid())
  routeCode      String          @unique
  routeName      String
  areaId         String?
  subAreaId      String?
  officeLocation OfficeLocation?
  serviceType    ServiceType     @default(PICK_AND_DROP)

  status RouteStatus @default(ACTIVE)

  shiftTiming String?

  pickupStartTime   DateTime?
  officeArrivalTime DateTime?
  dropTime          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  area            Area?            @relation(fields: [areaId], references: [id])
  subArea         SubArea?         @relation(fields: [subAreaId], references: [id])
  weeklySchedules WeeklySchedule[]
  rides           Ride[]
  trips           Trip[]

  @@index([areaId])
  @@index([subAreaId])
}

model Trip {
  id          String      @id @default(uuid())
  tripNumber  Int         @default(1)
  driverId    String?
  vehicleId   String?
  shiftTiming String?
  status      RouteStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  routeId     String
  route           Route            @relation(fields: [routeId], references: [id], onDelete: Cascade)
  driver          Driver?          @relation(fields: [driverId], references: [id])
  vehicle         Vehicle?         @relation(fields: [vehicleId], references: [id])
  weeklySchedules WeeklySchedule[]
  rides           Ride[]

  @@unique([routeId, tripNumber])
  @@index([routeId])
  @@index([driverId])
  @@index([vehicleId])
}

model Employee {
  id             String          @id @default(uuid())
  employeeCode   String          @unique
  name           String
  contactNumber  String?
  cnic           String?         @unique
  gender         Gender?
  designation    String?
  entity         Entity?
  officeLocation OfficeLocation?
  departmentId   String?
  areaId         String?
  subAreaId      String?
  blockId        String?
  address        String?
  serviceType    ServiceType     @default(PICK_AND_DROP)
  shiftTiming    String?
  status         EmployeeStatus  @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String? @unique

  department      Department?      @relation(fields: [departmentId], references: [id])
  area            Area?            @relation(fields: [areaId], references: [id])
  subArea         SubArea?         @relation(fields: [subAreaId], references: [id])
  block           Block?           @relation(fields: [blockId], references: [id])
  user            User?            @relation("EmployeeUser", fields: [userId], references: [id], onDelete: SetNull)
  weeklySchedules WeeklySchedule[]
  ridePassengers  RidePassenger[]
  attendances     Attendance[]
  complaints      Complaint[]
}

model WeeklySchedule {
  id        String   @id @default(uuid())
  weekStart DateTime

  employeeId String

  routeId String?

  tripId String?

  serviceType ServiceType @default(PICK_AND_DROP)

  driverId      String?
  vehicleId     String?
  vendorId      String?
  // Was `String?` — aligned with Vehicle.vehicleEntity / Employee.entity so
  // "IBEX"/"VW" can't drift into free text and can be cross-checked.
  vehicleEntity Entity?

  shiftTiming       String?
  // Were `String?` — sheet cells like "8:00PM" / "5::00 PM" / Excel serial
  // fractions can't be sorted, compared, or used in the pickup=arrival-2h
  // calculation as plain strings. Migrated to real DateTime (see
  // weeklySchedule_controller.js parseSheetTimeToDate/computePickupTime).
  // NOTE: run a backfill (re-parse existing string values with the same
  // parser) before/while applying this migration — see
  // CHANGES_AND_FOLLOWUPS.md.
  pickupTime        DateTime?
  officeArrivalTime DateTime?
  dropTime          DateTime?

  offDay String?

  monday    DayStatus @default(BOTH)
  tuesday   DayStatus @default(BOTH)
  wednesday DayStatus @default(BOTH)
  thursday  DayStatus @default(BOTH)
  friday    DayStatus @default(BOTH)
  saturday  DayStatus @default(OFF)
  sunday    DayStatus @default(OFF)

  status   ScheduleStatus @default(ACTIVE)
  isLocked Boolean        @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  route    Route?   @relation(fields: [routeId], references: [id])
  trip     Trip?    @relation(fields: [tripId], references: [id])
  driver   Driver?  @relation(fields: [driverId], references: [id])
  vehicle  Vehicle? @relation(fields: [vehicleId], references: [id])
  vendor   Vendor?  @relation(fields: [vendorId], references: [id])

  @@unique([employeeId, weekStart])
  @@index([weekStart])
  @@index([employeeId])
  @@index([tripId])
  @@index([weekStart, status, routeId])
}

model Ride {
  id        String   @id @default(uuid())
  rideDate  DateTime
  routeId   String
  driverId  String?
  vehicleId String?
  vendorId  String?
  tripId    String?
  trip      Trip?    @relation(fields: [tripId], references: [id])

  areaId            String?
  subAreaId         String?
  // Were `String?` — migrated to DateTime for the same reason as
  // WeeklySchedule's equivalents. rideplaing.js (not in this repo snapshot)
  // populates these from the WeeklySchedule template and needs updating to
  // pass Date objects through rather than copying strings.
  pickupTime        DateTime?
  officeArrivalTime DateTime?
  dropTime          DateTime?
  status            RideStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  route       Route           @relation(fields: [routeId], references: [id])
  driver      Driver?         @relation(fields: [driverId], references: [id])
  vehicle     Vehicle?        @relation(fields: [vehicleId], references: [id])
  vendor      Vendor?         @relation(fields: [vendorId], references: [id])
  area        Area?           @relation(fields: [areaId], references: [id])
  subArea     SubArea?        @relation(fields: [subAreaId], references: [id])
  passengers  RidePassenger[]
  attendances Attendance[]
  complaints  Complaint[]

  @@unique([driverId, tripId, rideDate], name: "ride_driver_trip_date_unique")
  @@index([routeId, rideDate])
  @@index([rideDate])
}

enum RideConfirmationStatus {
  PENDING
  CONFIRMED
  DECLINED
}

model RidePassenger {
  id         String @id @default(uuid())
  rideId     String
  employeeId String

  employeeName String?
  address      String?
  contact      String?
  area         String?
  subArea      String?

  confirmationStatus RideConfirmationStatus @default(PENDING)
  confirmedAt        DateTime?

  ride     Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([rideId, employeeId])
  @@index([rideId])
}

model Attendance {
  id           String           @id @default(uuid())
  rideDate     DateTime
  employeeId   String
  rideId       String?
  arrivalTime  DateTime?
  delayMinutes Int?
  status       AttendanceStatus @default(PRESENT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
  ride     Ride?    @relation(fields: [rideId], references: [id])

  @@unique([employeeId, rideDate])
}

model Complaint {
  id          String            @id @default(uuid())
  employeeId  String?
  driverId    String?
  vehicleId   String?
  rideId      String?
  category    ComplaintCategory @default(OTHER)
  title       String
  description String?
  status      ComplaintStatus   @default(OPEN)
  resolution  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee? @relation(fields: [employeeId], references: [id])
  driver   Driver?   @relation(fields: [driverId], references: [id])
  vehicle  Vehicle?  @relation(fields: [vehicleId], references: [id])
  ride     Ride?     @relation(fields: [rideId], references: [id])
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  passwordHash String?
  role         UserRole @default(EMPLOYEE)
  qrCode       String?  @unique @map("qr_code")
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee      Employee?      @relation("EmployeeUser")
  driver        Driver?        @relation("DriverUser")
  notifications Notification[]
  deviceTokens  DeviceToken[]
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  model     String
  recordId  String?
  before    Json?
  after     Json?
  ipAddress String?
  createdAt DateTime @default(now())
}

model ScheduleException {
  id           String   @id @default(uuid())
  weekStart    DateTime
  employeeCode String?
  rowNumber    Int?
  reason       String
  rawData      Json?
  resolved     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([weekStart])
}

model BulkUploadJob {
  id               String    @id @default(cuid())
  weekStart        DateTime
  status           String    @default("processing") // processing | completed | failed
  filePath         String
  totalRows        Int       @default(0)
  processedRows    Int       @default(0)
  batchSize        Int       @default(100)
  totalBatches     Int       @default(0)
  batchesCompleted Int       @default(0)
  result           Json?
  error            String?
  startedAt        DateTime  @default(now())
  completedAt      DateTime?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  
  @@index([weekStart, status])
}


model Notification {
  id        String             @id @default(uuid())
  userId    String
  title     String
  body      String?
  status    NotificationStatus @default(UNREAD)
  link      String?
  // Structured payload (e.g. { rideId, type: "RIDE_ASSIGNED" }) so the
  // mobile app can deep-link on tap without re-parsing `link`.
  data      Json?
  createdAt DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One row per device a user has logged into. A user can have several
// (e.g. phone + tablet, or a reinstall that generated a new push
// token) — pushes fan out to every active token and stale ones get
// flipped to isActive=false when Expo's push API reports them dead.
// `token` holds an Expo push token (ExponentPushToken[...]).
model DeviceToken {
  id         String         @id @default(uuid())
  userId     String
  token      String         @unique
  platform   DevicePlatform
  isActive   Boolean        @default(true)
  lastSeenAt DateTime       @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isActive])
}
