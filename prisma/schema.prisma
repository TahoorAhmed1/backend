generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model user {
  id         String   @id @default(uuid())
  email      String   @unique
  userRole  String?
  password   String
  name       String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  assignedTasks task[] @relation("AssignedTo")

  createdTasks task[] @relation("CreatedBy")
}

model task {
  id          Int     @id @default(autoincrement())
  title       String
  description String?
  status      String  @default("todo")

  userId String?
  user   user?   @relation("AssignedTo", fields: [userId], references: [id], onDelete: SetNull)

  createdBy String
  admin     user   @relation("CreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedBy String?
}
