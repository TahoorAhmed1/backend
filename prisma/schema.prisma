generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ╔══════════════════════════════════════════════════════════════╗
// ║                         ENUMS                               ║
// ╚══════════════════════════════════════════════════════════════╝

enum UserRole {
  SUPER_ADMIN
  HR_ADMIN
  SUPERVISOR
  DRIVER
  EMPLOYEE
}

enum Entity {
  IBEX
  VW
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ServiceType {
  PICK_DROP
  DROP_ONLY
  PICK_ONLY
}

enum ShiftType {
  MORNING
  EVENING
  NIGHT
  CUSTOM
}

enum WeekDay {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum RideStatus {
  PENDING
  STARTED
  ARRIVED
  COMPLETED
  CANCELLED
}

enum QrStatus {
  ACTIVE
  EXPIRED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  NO_SHOW
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

enum ComplaintCategory {
  DRIVER_BEHAVIOUR
  VEHICLE_CONDITION
  ROUTE_ISSUE
  TIMING_DELAY
  SCHEDULING
  OTHER
}

enum DriverStatus {
  AVAILABLE
  ON_RIDE
  OFFLINE
  ON_BREAK
  INACTIVE
}

enum DriverShiftType {
  SHIFT_12_HOUR
  SHIFT_24_HOUR
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  BREAKDOWN
  BLACKLISTED
}

enum VehicleType {
  CAR
  VAN
  HIJET
  KARVAN
  BUS
}

// ─────────────────────────────────────────────
//  FIX #1 — VehicleStatus normalization
//  Raw data has: "In-Acive", "IN- Active",
//  "Black List", "Released", "In-Acive-2023" etc.
//  All mapped to INACTIVE / BLACKLISTED / INACTIVE
//  at seed time via normalizeVehicleStatus()
// ─────────────────────────────────────────────

enum UploadStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  PARTIAL
}

enum PickupPolicy {
  ROUTE_BASED
  DOOR_TO_DOOR
  HYBRID
}

enum PickupMode {
  ROUTE_BASED
  PICKUP_POINT
  DOOR_TO_DOOR
}

enum NotificationType {
  ARRIVAL_ALERT
  RIDE_ASSIGNED
  RIDE_CANCELLED
  RIDE_UPDATED
  EMERGENCY
  GENERAL
}

enum ExceptionType {
  NO_DRIVER_AVAILABLE
  VEHICLE_BREAKDOWN
  AREA_NOT_COVERED
  SHIFT_MISMATCH
  NO_ROUTE_MAPPED
  OTHER
}

enum ExceptionStatus {
  OPEN
  RESOLVED
  ESCALATED
}

enum ExceptionSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FinalScheduleStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  CANCELLED
}

// ─────────────────────────────────────────────
//  Coverage status for CT pick/drop areas
// ─────────────────────────────────────────────
enum CoverageType {
  COVERAGE
  NON_COVERAGE
}

// ╔══════════════════════════════════════════════════════════════╗
// ║                         USERS                               ║
// ╚══════════════════════════════════════════════════════════════╝

model User {
  id       String   @id @default(uuid())
  email    String   @unique
  password String?
  name     String
  role     UserRole
  isActive Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee?
  driver   Driver?

  auditLogs          AuditLog[]
  uploads            ScheduleUpload[]
  publishedSchedules FinalSchedule[]  @relation("PublishedBy")
  resolvedExceptions ExceptionLog[]   @relation("ResolvedBy")
  createdRides       Ride[]           @relation("CreatedBy")
}

// ╔══════════════════════════════════════════════════════════════╗
// ║                         OFFICE                              ║
// ╚══════════════════════════════════════════════════════════════╝

model Office {
  id       String  @id @default(uuid())
  name     String  @unique
  code     String  @unique
  address  String?
  cityId   String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city      City?      @relation(fields: [cityId], references: [id])
  employees Employee[]
}

// ╔══════════════════════════════════════════════════════════════╗
// ║           CITY  →  AREA  →  SUBAREA  →  BLOCK               ║
// ╚══════════════════════════════════════════════════════════════╝

model City {
  id   String @id @default(uuid())
  name String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  areas     Area[]
  routes    Route[]
  employees Employee[]
  offices   Office[]
}

model Area {
  id     String @id @default(uuid())
  cityId String
  name   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city      City      @relation(fields: [cityId], references: [id])
  subAreas  SubArea[]
  employees Employee[]

  @@unique([cityId, name])
}

model SubArea {
  id           String       @id @default(uuid())
  areaId       String
  name         String
  isCovered    Boolean      @default(true)
  pickupPolicy PickupPolicy @default(ROUTE_BASED)
  routeCode    String?

  aliases String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  area   Area   @relation(fields: [areaId], references: [id])
  route  Route? @relation(fields: [routeCode], references: [code])

  blocks     Block[]
  employees  Employee[]
  routeStops RouteStop[]

  @@unique([areaId, name])
}

model Block {
  id        String  @id @default(uuid())
  subAreaId String
  name      String
  latitude  Float?
  longitude Float?
  isActive  Boolean @default(true)

  aliases String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subArea    SubArea    @relation(fields: [subAreaId], references: [id])
  employees  Employee[]
  routeStops RouteStop[]

  weeklyDayEntries     WeeklyScheduleDayEntry[]
  finalScheduleEntries FinalScheduleEntry[]

  @@unique([subAreaId, name])
}

// ╔══════════════════════════════════════════════════════════════╗
// ║            DEPARTMENT  /  CAMPAIGN  /  BATCH                ║
// ╚══════════════════════════════════════════════════════════════╝

model Department {
  id   String @id @default(uuid())
  name String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]
}

model Campaign {
  id       String  @id @default(uuid())
  name     String
  code     String  @unique
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]
}

model Batch {
  id        String    @id @default(uuid())
  code      String    @unique
  label     String?
  startDate DateTime?
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]
}

// ╔══════════════════════════════════════════════════════════════╗
// ║                       EMPLOYEE                              ║
// ╚══════════════════════════════════════════════════════════════╝

model Employee {
  id           String  @id @default(uuid())
  employeeCode String  @unique
  userId       String? @unique

  departmentId String?
  campaignId   String?
  batchId      String?

  cityId    String?
  areaId    String?
  subAreaId String?
  blockId   String?

  officeId String?

  name          String
  contactNumber String?
  cnic          String?
  gender        Gender?
  designation   String?

  address   String
  latitude  Float?
  longitude Float?

  entity      Entity?
  serviceType ServiceType @default(PICK_DROP)

  kmPerDay   Float?
  nod        Int?
  kmPerMonth Float?

  dateOfJoining  DateTime?
  lastWorkingDay DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User?       @relation(fields: [userId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  campaign   Campaign?   @relation(fields: [campaignId], references: [id])
  batch      Batch?      @relation(fields: [batchId], references: [id])
  city       City?       @relation(fields: [cityId], references: [id])
  area       Area?       @relation(fields: [areaId], references: [id])
  subArea    SubArea?    @relation(fields: [subAreaId], references: [id])
  block      Block?      @relation(fields: [blockId], references: [id])
  office     Office?     @relation(fields: [officeId], references: [id])

  weeklyEntries        WeeklyScheduleEntry[]
  finalScheduleEntries FinalScheduleEntry[]
  assignments          RideAssignment[]
  attendances          Attendance[]
  notifications        Notification[]
  complaints           Complaint[]
  exceptions           ExceptionLog[]

  // ─── FIX #4 — cross-reference to route assignments ───────────
  routeAssignments EmployeeRouteAssignment[]
  // ─────────────────────────────────────────────────────────────

  // ─── FIX #5 — cross-reference to historical PD records ───────
  pdHistoricalRecords PdHistoricalRecord[]
  // ─────────────────────────────────────────────────────────────
}

// ╔══════════════════════════════════════════════════════════════╗
// ║                    VENDOR                                   ║
// ╚══════════════════════════════════════════════════════════════╝

model Vendor {
  id             String  @id @default(uuid())
  name           String  @unique
  shortName      String?
  parentVendorId String?
  contactPerson  String?
  phone          String?
  email          String?
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parentVendor Vendor?  @relation("VendorHierarchy", fields: [parentVendorId], references: [id])
  subVendors   Vendor[] @relation("VendorHierarchy")

  vehicles Vehicle[]
  drivers  Driver[]
  routes   Route[]
}

// ╔══════════════════════════════════════════════════════════════╗
// ║                       DRIVER                                ║
// ╚══════════════════════════════════════════════════════════════╝

model Driver {
  id             String          @id @default(uuid())
  userId         String?         @unique
  vendorId       String?
  defaultRouteId String?

  name          String
  phone         String?
  licenseNumber String?
  cnic          String?
  status        DriverStatus    @default(AVAILABLE)
  isActive      Boolean         @default(true)

  shiftType        DriverShiftType @default(SHIFT_12_HOUR)
  shiftStartMinute Int?
  shiftEndMinute   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User?   @relation(fields: [userId], references: [id])
  vendor       Vendor? @relation(fields: [vendorId], references: [id])
  defaultRoute Route?  @relation("DriverDefaultRoute", fields: [defaultRouteId], references: [id])

  // ─── FIX #2 — explicit vehicle assignment (replaces string matching) ───
  currentVehicleId String?  @unique   // the vehicle this driver is CURRENTLY assigned to
  currentVehicle   Vehicle? @relation("CurrentDriver", fields: [currentVehicleId], references: [id])
  // ──────────────────────────────────────────────────────────────────────

  primaryVehicles   Vehicle[] @relation("PrimaryDriver")
  secondaryVehicles Vehicle[] @relation("SecondaryDriver")

  rides                Ride[]
  rideQrCodes          RideQrCode[]
  complaints           Complaint[]
  exceptions           ExceptionLog[]
  finalScheduleEntries FinalScheduleEntry[]

  // ─── FIX #2 — paired-driver rows: each driver gets his own rows ───────
  routeAssignmentsAsPrimary   EmployeeRouteAssignment[] @relation("PrimaryDriverAssignment")
  routeAssignmentsAsSecondary EmployeeRouteAssignment[] @relation("SecondaryDriverAssignment")
  vehicleRouteAssignments     VehicleRouteAssignment[]
  // ──────────────────────────────────────────────────────────────────────
}

// ╔══════════════════════════════════════════════════════════════╗
// ║                      VEHICLE                                ║
// ╚══════════════════════════════════════════════════════════════╝

model Vehicle {
  id                String        @id @default(uuid())
  vendorId          String?
  primaryDriverId   String?       // ─── FIX #6: explicit FK ───
  secondaryDriverId String?       // ─── FIX #6: explicit FK ───
  vehicleNumber     String        @unique
  type              VehicleType
  make              String?
  model             String?
  year              String?
  capacity          Int           @default(4)
  status            VehicleStatus @default(ACTIVE)
  isOperational     Boolean       @default(true)
  notes             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor          Vendor? @relation(fields: [vendorId], references: [id])
  primaryDriver   Driver? @relation("PrimaryDriver",   fields: [primaryDriverId],   references: [id])
  secondaryDriver Driver? @relation("SecondaryDriver", fields: [secondaryDriverId], references: [id])

  // ─── FIX #6 — reverse side of currentVehicle on Driver ───────────────
  currentDriver Driver? @relation("CurrentDriver")
  // ──────────────────────────────────────────────────────────────────────

  rides                Ride[]
  exceptions           ExceptionLog[]
  finalScheduleEntries FinalScheduleEntry[]

  // ─── FIX #6 — vehicle→route→driver junction ──────────────────────────
  vehicleRouteAssignments VehicleRouteAssignment[]
  // ──────────────────────────────────────────────────────────────────────
}

// ╔══════════════════════════════════════════════════════════════╗
// ║   FIX #6 — VehicleRouteAssignment                           ║
// ║                                                             ║
// ║  Explicitly links a Vehicle to a Route and the Driver       ║
// ║  who operates that vehicle on that route at a given time.   ║
// ║  Replaces the implicit string-match approach in the old     ║
// ║  seed where vehicle→driver linkage required guessing.       ║
// ║                                                             ║
// ║  Example: CY-8600 → Route "Akram 0313 | 9AM-5PM" → Akram   ║
// ╚══════════════════════════════════════════════════════════════╝

model VehicleRouteAssignment {
  id        String @id @default(uuid())
  vehicleId String
  routeId   String
  driverId  String

  assignedAt DateTime  @default(now())
  releasedAt DateTime? // null = currently active

  shiftTimingLabel String? // e.g. "9:00 AM - 5:00 PM" — display only
  notes            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  route   Route   @relation(fields: [routeId], references: [id])
  driver  Driver  @relation(fields: [driverId], references: [id])

  @@unique([vehicleId, routeId, driverId, assignedAt])
  @@index([routeId])
  @@index([driverId])
  @@index([vehicleId])
}

// ╔══════════════════════════════════════════════════════════════╗
// ║                       ROUTES                                ║
// ║                                                             ║
// ║  FIX #3 — driverId FK added                                 ║
// ║  FIX #2 — primaryDriverId / secondaryDriverId for paired    ║
// ║            drivers (e.g. "Asim / Azam" becomes two FKs)     ║
// ║                                                             ║
// ║  The route_name in the original seed encoded both the       ║
// ║  driver name and the shift timing as a single string:       ║
// ║    "Asim 03006853754 / Azam 03092500123 | 9:00 PM - 6:00 AM"║
// ║  We now store driver references as proper FKs and keep the  ║
// ║  raw string in driverLabel for display / legacy lookups.    ║
// ╚══════════════════════════════════════════════════════════════╝

model Route {
  id         String  @id @default(uuid())
  cityId     String?
  name       String
  code       String  @unique
  vendorId   String?

  // FIX #3: proper driver FK (was missing entirely)
  primaryDriverId   String? // driver who normally runs this route
  secondaryDriverId String? // relief / paired driver (e.g. "Asim / Azam")

  // Display / legacy reference — the original combined string
  // e.g. "Asim 03006853754 / Azam 03092500123"
  driverLabel  String?

  shiftTiming  String? // e.g. "9:00 PM - 6:00 AM"
  startPoint   String?
  endPoint     String?
  vehicleType  String? // normalized at app layer; raw from Excel
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city            City?   @relation(fields: [cityId], references: [id])
  vendor          Vendor? @relation(fields: [vendorId], references: [id])
  primaryDriver   Driver? @relation("DriverDefaultRoute", fields: [primaryDriverId], references: [id])

  subAreas SubArea[]
  stops    RouteStop[]
  rides    Ride[]

  exceptions           ExceptionLog[]
  finalScheduleEntries FinalScheduleEntry[]
  weeklyDayEntries     WeeklyScheduleDayEntry[]

  // FIX #6 — vehicle assignments
  vehicleRouteAssignments VehicleRouteAssignment[]

  // FIX #2 — employee assignments via the fixed junction table
  employeeRouteAssignments EmployeeRouteAssignment[]
}

model RouteStop {
  id        String  @id @default(uuid())
  routeId   String
  subAreaId String?
  blockId   String?
  label     String
  sequence  Int
  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now())

  route   Route    @relation(fields: [routeId], references: [id])
  subArea SubArea? @relation(fields: [subAreaId], references: [id])
  block   Block?   @relation(fields: [blockId], references: [id])

  @@unique([routeId, sequence])
}

// ╔══════════════════════════════════════════════════════════════╗
// ║  FIX #2 + FIX #4 — EmployeeRouteAssignment                  ║
// ║                                                             ║
// ║  PROBLEM (old seed):                                        ║
// ║    driver_name stored as raw string:                        ║
// ║      "Asim 03006853754 / Azam 03092500123"                  ║
// ║    → can't FK-join to drivers table                         ║
// ║    → employee_id NULL for ~200 rows (emp not in May master) ║
// ║                                                             ║
// ║  FIX:                                                       ║
// ║    1. primaryDriverId + secondaryDriverId as proper FKs     ║
// ║    2. employeeId nullable with isUnresolved flag            ║
// ║       When NULL: rawEmployeeCode holds the original number  ║
// ║       so the record is not lost and can be reconciled later ║
// ║    3. driverLabel kept for display (the raw combined string) ║
// ╚══════════════════════════════════════════════════════════════╝

model EmployeeRouteAssignment {
  id         String  @id @default(uuid())
  routeId    String

  // FIX #4: employeeId nullable; isUnresolved flags the ~200 gap rows
  employeeId     String?
  rawEmployeeCode String? // original emp code when employee not found in master
  isUnresolved   Boolean @default(false) // true when employeeId is NULL

  // FIX #2: paired-driver rows split into two proper FKs
  primaryDriverId   String?
  secondaryDriverId String?
  driverLabel       String? // original combined string, kept for audit

  vendorName        String?
  campaign          String?
  shiftTiming       String?
  vehicleType       String?
  officeArrivalTime String?
  dayOff            String?
  area              String?
  address           String?
  driverStatus      String?
  shiftStatus       String?
  adminPoc          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  route           Route    @relation(fields: [routeId], references: [id])
  employee        Employee? @relation(fields: [employeeId], references: [id])
  primaryDriver   Driver?   @relation("PrimaryDriverAssignment",   fields: [primaryDriverId],   references: [id])
  secondaryDriver Driver?   @relation("SecondaryDriverAssignment", fields: [secondaryDriverId], references: [id])

  @@index([employeeId])
  @@index([routeId])
  @@index([primaryDriverId])
  @@index([isUnresolved]) // fast query to find all unresolved gaps
}

// ╔══════════════════════════════════════════════════════════════╗
// ║  CT COVERAGE AREAS                                          ║
// ║  From CT_pick_and_drop_points_Coverage_and_Non_Coverage.xlsx ║
// ╚══════════════════════════════════════════════════════════════╝

model CtCoverageArea {
  id           String       @id @default(uuid())
  areaName     String       @unique
  coverageType CoverageType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ╔══════════════════════════════════════════════════════════════╗
// ║  FIX #5 — PdHistoricalRecord                                ║
// ║                                                             ║
// ║  PROBLEM (old seed):                                        ║
// ║    emp_id stored as raw integer with no FK to employees     ║
// ║    → cross-month queries require string matching            ║
// ║                                                             ║
// ║  FIX:                                                       ║
// ║    employeeId: proper FK to Employee                        ║
// ║    rawEmpCode: the original integer preserved for audit     ║
// ║    isUnresolved: true when employeeId cannot be matched     ║
// ║       (historical records may predate the employee in the   ║
// ║        current master — they are NOT deleted, just flagged) ║
// ╚══════════════════════════════════════════════════════════════╝

model PdHistoricalRecord {
  id          String @id @default(uuid())

  // FIX #5: proper FK
  employeeId  String?
  rawEmpCode  String  // original emp_id integer as string — never null
  isUnresolved Boolean @default(false)

  department  String?
  location    String?  // office code from the historical file
  shiftTiming String?
  entity      String?
  fullName    String?
  phone       String?
  area        String?
  address     String?
  dataMonth   String   // "2026-03" format

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee? @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([dataMonth])
  @@index([isUnresolved])
}

// ╔══════════════════════════════════════════════════════════════╗
// ║              WEEKLY SCHEDULE  (provider upload)             ║
// ╚══════════════════════════════════════════════════════════════╝

model WeeklySchedule {
  id            String    @id @default(uuid())
  name          String?
  effectiveFrom DateTime
  effectiveTo   DateTime
  uploadId      String?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  upload  ScheduleUpload? @relation(fields: [uploadId], references: [id])
  entries WeeklyScheduleEntry[]

  @@unique([effectiveFrom, effectiveTo])
  @@index([effectiveFrom, effectiveTo])
}

model WeeklyScheduleEntry {
  id               String @id @default(uuid())
  weeklyScheduleId String
  employeeId       String

  serviceType  ServiceType?
  subAreaId    String?
  blockId      String?
  pickupPoint  String?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  weeklySchedule WeeklySchedule         @relation(fields: [weeklyScheduleId], references: [id], onDelete: Cascade)
  employee       Employee               @relation(fields: [employeeId], references: [id])
  dayEntries     WeeklyScheduleDayEntry[]

  @@unique([weeklyScheduleId, employeeId])
  @@index([employeeId])
}

model WeeklyScheduleDayEntry {
  id                    String  @id @default(uuid())
  weeklyScheduleEntryId String

  weekDay      WeekDay
  pickupMinute Int
  dropMinute   Int

  routeId String?
  blockId String?

  shiftLabel String?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  weeklyScheduleEntry  WeeklyScheduleEntry  @relation(fields: [weeklyScheduleEntryId], references: [id], onDelete: Cascade)
  route                Route?               @relation(fields: [routeId], references: [id])
  block                Block?               @relation(fields: [blockId], references: [id])
  finalScheduleEntries FinalScheduleEntry[]

  @@unique([weeklyScheduleEntryId, weekDay])
  @@index([weekDay])
  @@index([routeId])
}

// ╔══════════════════════════════════════════════════════════════╗
// ║                  FINAL SCHEDULE                             ║
// ╚══════════════════════════════════════════════════════════════╝

model FinalSchedule {
  id            String              @id @default(uuid())
  scheduleDate  DateTime
  status        FinalScheduleStatus @default(DRAFT)
  publishedById String?
  publishedAt   DateTime?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  publishedBy User?                @relation("PublishedBy", fields: [publishedById], references: [id])
  entries     FinalScheduleEntry[]

  @@unique([scheduleDate])
  @@index([scheduleDate, status])
}

model FinalScheduleEntry {
  id              String @id @default(uuid())
  finalScheduleId String
  employeeId      String

  weeklyDayEntryId String?

  vehicleId String?
  driverId  String?
  routeId   String?
  blockId   String?
  officeId  String?

  pickupMinute Int?
  dropMinute   Int?
  shiftLabel   String?
  pickupPoint  String?

  rideId String?
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  finalSchedule  FinalSchedule          @relation(fields: [finalScheduleId], references: [id], onDelete: Cascade)
  employee       Employee               @relation(fields: [employeeId], references: [id])
  weeklyDayEntry WeeklyScheduleDayEntry? @relation(fields: [weeklyDayEntryId], references: [id])
  vehicle        Vehicle?               @relation(fields: [vehicleId], references: [id])
  driver         Driver?                @relation(fields: [driverId], references: [id])
  route          Route?                 @relation(fields: [routeId], references: [id])
  block          Block?                 @relation(fields: [blockId], references: [id])
  ride           Ride?                  @relation(fields: [rideId], references: [id])

  @@unique([finalScheduleId, employeeId])
  @@index([employeeId])
  @@index([rideId])
  @@index([driverId])
  @@index([vehicleId])
  @@index([weeklyDayEntryId])
}

// ╔══════════════════════════════════════════════════════════════╗
// ║                        RIDES                                ║
// ╚══════════════════════════════════════════════════════════════╝

model Ride {
  id          String  @id @default(uuid())
  routeId     String?
  driverId    String?
  vehicleId   String?
  createdById String?

  scheduledDate  DateTime
  pickupMode     PickupMode
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  actualStart    DateTime?
  arrivedAt      DateTime?
  actualEnd      DateTime?

  status         RideStatus @default(PENDING)
  isAutoAssigned Boolean    @default(false)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  route     Route?   @relation(fields: [routeId], references: [id])
  driver    Driver?  @relation(fields: [driverId], references: [id])
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])
  createdBy User?    @relation("CreatedBy", fields: [createdById], references: [id])

  assignments          RideAssignment[]
  qrCodes              RideQrCode[]
  attendances          Attendance[]
  notifications        Notification[]
  complaints           Complaint[]
  exceptions           ExceptionLog[]
  finalScheduleEntries FinalScheduleEntry[]

  @@index([scheduledDate, status])
  @@index([driverId, scheduledDate])
  @@index([vehicleId, scheduledDate])
}

model RideAssignment {
  id             String  @id @default(uuid())
  rideId         String
  employeeId     String
  pickupSequence Int?
  pickupPoint    String?
  isNoShow       Boolean @default(false)
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ride     Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([rideId, employeeId])
  @@index([employeeId])
}

model RideQrCode {
  id       String @id @default(uuid())
  rideId   String
  driverId String

  token   String   @unique @default(uuid())
  payload Json
  status  QrStatus @default(ACTIVE)

  expiresAt   DateTime
  generatedAt DateTime  @default(now())
  expiredAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ride        Ride       @relation(fields: [rideId], references: [id], onDelete: Cascade)
  driver      Driver     @relation(fields: [driverId], references: [id])
  attendances Attendance[]

  @@unique([rideId])
  @@index([token])
  @@index([status, expiresAt])
}

model Attendance {
  id         String           @id @default(uuid())
  rideId     String
  employeeId String
  qrCodeId   String?

  status    AttendanceStatus
  scannedAt DateTime?
  lateByMin Int?

  scanLatitude  Float?
  scanLongitude Float?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ride     Ride        @relation(fields: [rideId], references: [id])
  employee Employee    @relation(fields: [employeeId], references: [id])
  qrCode   RideQrCode? @relation(fields: [qrCodeId], references: [id])

  @@unique([rideId, employeeId])
  @@index([employeeId])
  @@index([rideId])
  @@index([status])
  @@index([scannedAt])
}

model Complaint {
  id          String            @id @default(uuid())
  rideId      String?
  employeeId  String?
  driverId    String?
  category    ComplaintCategory @default(OTHER)
  title       String
  description String?
  status      ComplaintStatus   @default(OPEN)
  resolution  String?
  resolvedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ride     Ride?     @relation(fields: [rideId], references: [id])
  employee Employee? @relation(fields: [employeeId], references: [id])
  driver   Driver?   @relation(fields: [driverId], references: [id])
}

model Notification {
  id         String           @id @default(uuid())
  employeeId String
  rideId     String?
  type       NotificationType
  title      String
  message    String
  isRead     Boolean          @default(false)
  sentAt     DateTime         @default(now())

  createdAt DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])
  ride     Ride?    @relation(fields: [rideId], references: [id])

  @@index([employeeId, isRead])
}

model ExceptionLog {
  id         String  @id @default(uuid())
  rideId     String?
  routeId    String?
  employeeId String?
  driverId   String?
  vehicleId  String?

  type     ExceptionType
  severity ExceptionSeverity @default(MEDIUM)
  status   ExceptionStatus   @default(OPEN)
  message  String
  details  Json?

  resolvedById String?
  resolvedAt   DateTime?
  resolution   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ride       Ride?     @relation(fields: [rideId], references: [id])
  route      Route?    @relation(fields: [routeId], references: [id])
  employee   Employee? @relation(fields: [employeeId], references: [id])
  driver     Driver?   @relation(fields: [driverId], references: [id])
  vehicle    Vehicle?  @relation(fields: [vehicleId], references: [id])
  resolvedBy User?     @relation("ResolvedBy", fields: [resolvedById], references: [id])

  @@index([type])
  @@index([status])
  @@index([severity])
  @@index([createdAt])
}

model ScheduleUpload {
  id            String       @id @default(uuid())
  uploadedById  String
  fileName      String
  status        UploadStatus @default(PENDING)
  totalRows     Int          @default(0)
  processedRows Int          @default(0)
  failedRows    Int          @default(0)
  skippedRows   Int          @default(0)
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  uploadedBy      User                  @relation(fields: [uploadedById], references: [id])
  errors          ScheduleUploadError[]
  weeklySchedules WeeklySchedule[]
}

model ScheduleUploadError {
  id           String @id @default(uuid())
  uploadId     String
  rowNumber    Int
  errorType    String
  errorMessage String
  rawData      Json

  createdAt DateTime @default(now())

  upload ScheduleUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
}

model VendorDailySummary {
  id               String   @id @default(uuid())
  date             DateTime
  vendorName       String
  totalRides       Int      @default(0)
  completedRides   Int      @default(0)
  lateRides        Int      @default(0)
  cancelledRides   Int      @default(0)
  noShowCount      Int      @default(0)
  lostHoursMinutes Int      @default(0)
  usersAffected    Int      @default(0)

  createdAt DateTime @default(now())

  @@unique([date, vendorName])
}

model AuditLog {
  id      String @id @default(uuid())
  userId  String
  action  String
  details Json?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
